# Copie este archivo como .env y reemplace los valores de ejemplo. NO suba .env a GitHub.
PORT=3000

# Genere un secreto propio para firmar las sesiones.
JWT_SECRET=

# Usuario final de la aplicacion (solo puede ejecutar procedimientos y leer vistas de PRODUCCION)
ORACLE_USER=USR_FINAL
ORACLE_PASSWORD="CLAVE_DEL_USUARIO_ORACLE"

# Esquema dueno de los objetos (se antepone a cada procedimiento y vista)
ORACLE_SCHEMA=EXTREMETECH_PROD

# Alias existente en tnsnames.ora del wallet (por ejemplo lenguajesdebd_high)
ORACLE_CONNECT_STRING=ALIAS_DEL_TNSNAMES

# Carpeta donde se extrajo el wallet (contiene tnsnames.ora y ewallet.pem)
ORACLE_WALLET_LOCATION=C:/oracle/wallet_LenguajesdeBD

# Clave definida al descargar el wallet (no es la clave del usuario Oracle)
ORACLE_WALLET_PASSWORD="CLAVE_DEL_WALLET"

# true = datos de ejemplo, sin conectarse a Oracle (para revisar las pantallas)
MODO_DEMO=false

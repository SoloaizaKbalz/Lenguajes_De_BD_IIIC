<%
const iconos = {
  panel:'<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>',
  productos:'<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
  ventas:'<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>',
  clientes:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  empleados:'<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
  devoluciones:'<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5 5.5 5.5 0 0 1-5.5 5.5H11"/>',
  garantias:'<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  servicio:'<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/>',
  reportes:'<path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>'
};
const menu = [
  ['panel','Panel','/panel'], ['productos','Productos','/productos'], ['ventas','Ventas','/ventas'], ['clientes','Clientes','/clientes'],
  ['empleados','Empleados','/empleados'], ['devoluciones','Devoluciones','/devoluciones'], ['garantias','Garantías','/garantias'],
  ['servicio','Servicio técnico','/servicio-tecnico'], ['reportes','Reportes','/reportes']
];
const iniciales = (usuario && usuario.nombre ? usuario.nombre.split(' ').slice(0,2).map(p=>p[0]).join('') : 'G2');
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · ExtremeTech</title>
  <link rel="icon" href="/img/logo.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Lexend:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
<% if (demo) { %><div class="banner-demo">MODO DEMO: datos de ejemplo, sin conexión a Oracle</div><% } %>
<div class="app">
  <aside class="sidebar">
    <div class="logo"><img src="/img/logo.svg" alt=""> ExtremeTech</div>
    <nav>
      <% menu.forEach(m => { const activo = ruta === m[2] || ruta.startsWith(m[2] + '/'); %>
        <a class="nav-item <%= activo ? 'activo' : '' %>" href="<%= m[0]==='ventas' ? '/ventas/nueva' : m[2] %>">
          <svg viewBox="0 0 24 24"><%- iconos[m[0]] %></svg><%= m[1] %>
        </a>
      <% }) %>
      <a class="nav-item" href="/salir">
        <svg viewBox="0 0 24 24"><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/><path d="M14 3h5a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-5"/></svg>
        Cerrar sesión
      </a>
    </nav>
    <div class="usuario">
      <div class="avatar"><%= iniciales %></div>
      <div class="usuario-datos"><b><%= usuario ? usuario.nombre.split(' ').slice(0,2).join(' ') : 'Grupo 2' %></b><small><%= usuario ? usuario.rol : '' %></small></div>
    </div>
  </aside>
  <main class="contenido">
    <% if (ok) { %><div class="alerta ok"><%= ok %></div><% } %>
    <% if (error) { %><div class="alerta error"><%= error %></div><% } %>
